{
  "name": "excalicap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run patch:excalidraw && vite",
    "build": "npm run patch:excalidraw && npm run sync:fonts && tsc --noEmit && vite build",
    "build:obsidian": "npm run patch:excalidraw && npm run sync:fonts && tsc --noEmit && node esbuild.obsidian.mjs production",
    "postinstall": "npm run patch:excalidraw && npm run sync:fonts",
    "patch:excalidraw": "node scripts/patch-excalidraw-presentation-fonts.mjs",
    "sync:fonts": "node scripts/sync-excalidraw-fonts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "esbuild": "^0.28.1",
    "jsdom": "29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
